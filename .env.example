# Copy to .env.ms (Medical Sciences) and .env.ls (Life Sciences) and edit. One file per journal / domain.
# ms = IJMMS, ls = IJMLS
JOURNAL=ms
# ms: 3001, ls: 3002 (nginx proxies the domain to this port)
PORT=3001
# exact public address, https, no trailing slash
SITE_URL=https://www.your-ijmms-domain.org
# ls: .../ijmls
DATABASE_URL=postgres://journal:CHANGE_ME@127.0.0.1:5432/ijmms
# uploads, figures and generated PDFs (ls: /var/lib/journals/ijmls)
DATA_DIR=/var/lib/journals/ijmms
# openssl rand -hex 32
SESSION_SECRET=PUT_A_LONG_RANDOM_STRING_HERE
# optional first admin password; if empty one is generated into DATA_DIR/admin-initial-password.txt
ADMIN_PASSWORD=

# E-mail (SMTP). Without it, mails wait in Admin > Outbox. Gmail/Workspace: smtp.gmail.com, 587, app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true for port 465
SMTP_SECURE=false

# Optional: Crossref direct deposit (needs an active Crossref membership + registered DOI prefix)
CROSSREF_USER=
CROSSREF_PASS=
# CHROME_PATH=/usr/bin/chromium  # only if Chrome/Chromium is not found automatically
HOST=127.0.0.1
