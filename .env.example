# Copy to .env.ms (Medical Sciences) and .env.ls (Life Sciences) and edit. One file per journal / domain.
JOURNAL=ms                       # ms = IJMMS, ls = IJMLS
PORT=3001                        # ms: 3001, ls: 3002 (nginx proxies the domain to this port)
SITE_URL=https://www.your-ijmms-domain.org   # exact public address, https, no trailing slash
DATABASE_URL=postgres://journal:CHANGE_ME@127.0.0.1:5432/ijmms   # ls: .../ijmls
DATA_DIR=/var/lib/journals/ijmms # uploads, figures and generated PDFs (ls: /var/lib/journals/ijmls)
SESSION_SECRET=PUT_A_LONG_RANDOM_STRING_HERE   # openssl rand -hex 32
ADMIN_PASSWORD=                  # optional first admin password; if empty one is generated into DATA_DIR/admin-initial-password.txt

# E-mail (SMTP). Without it, mails wait in Admin > Outbox. Gmail/Workspace: smtp.gmail.com, 587, app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false                # true for port 465

# Optional: Crossref direct deposit (needs an active Crossref membership + registered DOI prefix)
CROSSREF_USER=
CROSSREF_PASS=
# CHROME_PATH=/usr/bin/chromium  # only if Chrome/Chromium is not found automatically
HOST=127.0.0.1
